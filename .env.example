# Скопируй в .env и заполни значения

# Секретный ключ Flask (сессии, CSRF)
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замени-на-случайную-строку-минимум-32-символа

# Режим отладки (1 — только при разработке, 0 — продакшн)
FLASK_DEBUG=0

# Токен Discogs API (https://www.discogs.com/settings/developers)
DISCOGS_TOKEN=
